# Put your custom commands here that should be executed once
# the system init finished. By default this file does nothing.

# Wait for lan-wasp interface to come up
ok=0
while true; do
  if ip link show lan-wasp | grep -q "state UP"; then
    ok=$(($ok+1))
  else
    ok=0
  fi

  if [ $ok -gt 10 ]; then
    break
  fi

  sleep 1
done

# Reload avm_wasp module
if lsmod | grep -q avm_wasp ; then
  rmmod avm_wasp
fi
sleep 1
modprobe avm_wasp

# Wait for WASP to be reachable
ok=0
while true; do
  if ping -c1 -W1 192.168.1.2 2>&1 >/dev/null; then
    ok=$(($ok+1))
    sleep 1
  else
    ok=0
  fi

  if [ $ok -ge 10 ]; then
    break
  fi
done

# Base WASP settings (hostname, mtu, dhcp.lan.ignore, ra/dhcpv6 cleanup) are
# no longer set here: they already live in the network/dhcp/system packages
# embedded in files/etc/wasp-wireless/factory.template, and are unconditionally
# (re)applied by `wasp-wireless boot` right below, which would overwrite
# anything set in a separate ssh block here anyway.

# Restore saved wireless configuration, falling back to factory
/usr/sbin/wasp-wireless boot

exit 0
