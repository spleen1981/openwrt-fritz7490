package wireless

config wifi-device 'radio0'
 option type 'mac80211'
 option path 'pci0000:00/0000:00:00.0'
 option band '5g'
 option channel '44'
 option htmode 'HT40'
 option country 'DE'
 option cell_density '0'
 option txpower '23'

config wifi-iface 'default_radio0'
 option device 'radio0'
 option network 'lan'
 option mode 'ap'
 option ssid '__WIFI_SSID__'
 option encryption 'psk2'
 option key '__WIFI_PASSWORD__'
 option ocv '0'
 option ieee80211r '1'
 option nasid 'Fritz7490-5g'
 option mobility_domain '1234'
 option ft_over_ds '0'
 option ft_psk_generate_local '1'
 option ieee80211k '1'
 option ieee80211v '1'
 option ieee80211w '1'
 option bss_transition '1'
 option rrm_neighbor_report '1'
 option rrm_beacon_report '1'
 option disassoc_low_ack '1'
 option bss_load_update_period '60'
 option chan_util_avg_period '600'
 option wmm '1'
 option multicast_to_unicast '1'
 option wps_pushbutton '1'

config wifi-iface 'mesh0'
 option device 'radio0'
 option network 'lan'
 option mode 'mesh'
 option mesh_id 'mymesh'
 option encryption 'sae'
 option key '__MESH_PASSWORD__'
 option mesh_fwding '1'

